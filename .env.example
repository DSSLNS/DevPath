# Copy to .env.local for local development. Nothing here is required for guest mode.

# Required in production: a long random string used to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the site, e.g. https://devpath.example.com (http://localhost:3000 in development).
BETTER_AUTH_URL=http://localhost:3000

# Production database. When unset, a local SQLite file (.data/devpath.db) is used.
# DATABASE_URL=postgres://user:password@host:5432/devpath

# Optional: SQLite location for local development.
# SQLITE_PATH=.data/devpath.db

# Password-reset email via Resend. When unset, reset links are printed in the server console (development only).
# RESEND_API_KEY=
# EMAIL_FROM=DevPath <no-reply@your-domain.example>
